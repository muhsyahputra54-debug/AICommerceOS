# AICommerceOS production environment template
#
# Values are intentionally empty.
# Never commit real credentials.
# Configure these variables in the production runtime.

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_AGENT_MODEL=
OPENAI_API_KEY=
OPENAI_DESCRIPTION_MODEL=
OPENAI_MODEL=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
MARKETPLACE_TOKEN_ENCRYPTION_KEY=

# Publishing provider OAuth and token protection
PUBLISHING_PROVIDER_OAUTH_STATE_SECRET=
PUBLISHING_PROVIDER_TOKEN_ENCRYPTION_KEYS=
PUBLISHING_PROVIDER_TOKEN_ENCRYPTION_ACTIVE_VERSION=

# YouTube OAuth
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=

# Feature-specific: Midtrans billing configuration.
MIDTRANS_ENVIRONMENT=
MIDTRANS_SERVER_KEY=

# Feature-specific: Shopee marketplace connection.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Feature-specific: TikTok Creator OAuth and publishing.
TIKTOK_CREATOR_CLIENT_KEY=
TIKTOK_CREATOR_CLIENT_SECRET=
TIKTOK_CREATOR_REDIRECT_URI=

# Optional: Sentry server and browser observability.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Build-only: Sentry source-map upload authentication.
SENTRY_AUTH_TOKEN=
